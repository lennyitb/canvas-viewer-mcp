# Copy to .env and fill in. .env is gitignored — never commit it.

# Your school's Canvas host.
CANVAS_BASE_URL=https://yourschool.instructure.com

# Supply the token ONE of these ways (CANVAS_TOKEN wins):
#   1. CANVAS_TOKEN=9112~...
#   2. CANVAS_TOKEN_FILE=/run/secrets/canvas_token   <- how the container gets it
# With neither set, the default is ~/.config/canvas-viewer-mcp/token
# CANVAS_TOKEN_FILE=/run/secrets/canvas_token

# ---- Hosted deployment (OAuth for the remote connector) ----
# compose.yaml requires CANVAS_BASE_URL and PUBLIC_BASE_URL here and refuses to
# start rather than guess either. AUTH_PASSWORD_HASH is optional: leave it unset
# and the server prints a one-time pairing code to its logs on first run.
# Public URL Anthropic reaches this server on.
# PUBLIC_BASE_URL=https://canvas-viewer-mcp.example.com
# Optional. Argon2 hash of a connector login password you choose (never the
# password itself) from `canvas-probe hash-password`. Unset means the server
# issues a pairing code instead; setting it later revokes that code.
# AUTH_PASSWORD_HASH=

# ---- local use ----
# None of the above is needed for a local (stdio) run if
# ~/.config/canvas-viewer-mcp/config.toml holds base_url instead.
# `/canvas-viewer:setup` writes it for you. Environment variables set here
# always win over that file.
