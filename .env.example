# Copy to .env and fill in. .env is gitignored -- never commit it.
#
# This file is for a self-hosted deployment (docker compose) or a local run.
# A one-click Railway install collects the same values in its deploy form and
# needs no file at all; see README.md.

# ---- required ----------------------------------------------------------------

# Your school's Canvas host. The address bar while you are looking at Canvas
# works: a pasted deep link such as .../courses/12345 is trimmed to the host.
CANVAS_BASE_URL=https://yourschool.instructure.com

# The public HTTPS URL Claude reaches this server on.
#
# Required when you bring your own hostname. On Railway, Render or Fly the
# platform already publishes it (RAILWAY_PUBLIC_DOMAIN, RENDER_EXTERNAL_URL,
# FLY_APP_NAME) and the server reads it from there, so leave this unset unless
# you have put a custom domain in front.
#
# Get it wrong and the OAuth metadata this server advertises points at
# whatever host it names -- which means someone else's server, if you copied
# the value out of someone else's instructions.
PUBLIC_BASE_URL=https://canvas-viewer-mcp.example.com

# ---- the Canvas token --------------------------------------------------------
#
# Canvas -> Account -> Settings -> Approved Integrations -> "+ New Access Token".
# It grants full access to your Canvas account; treat it like a password.
#
# One of:
#   CANVAS_TOKEN=9112~...                          <- how a PaaS supplies it
#   CANVAS_TOKEN_FILE=/run/secrets/canvas_token    <- how the container does
# With neither set, the default is ~/.config/canvas-viewer-mcp/token.
#
# compose.yaml mounts the token as a file rather than an environment variable,
# so the value stays out of the process list and out of image layers.
# CANVAS_TOKEN_FILE=/run/secrets/canvas_token

# ---- the connector login (all optional) --------------------------------------
#
# Set none of these and the server issues itself a pairing code on first run
# and prints it once to its logs. Setting either password form revokes a code
# already issued.

# A plaintext password, hashed at startup. At least 12 characters.
# AUTH_PASSWORD=

# Or an argon2 hash from `canvas-probe hash-password`, if you would rather the
# plaintext never be stored. Quote it -- it contains `$`.
# AUTH_PASSWORD_HASH='$argon2id$v=19$...'

# ---- local (stdio) use -------------------------------------------------------
# None of the above is needed for a local run if
# ~/.config/canvas-viewer-mcp/config.toml holds base_url instead, with the
# token in ~/.config/canvas-viewer-mcp/token. Environment variables always win
# over that file.
